local function createSlider(parent, text, defaultPercent, callback)
    local row = Instance.new("Frame")
    row.Size = UDim2.new(1, 0, 0, 25)
    row.BackgroundTransparency = 1
    row.Parent = parent

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(0.7, 0, 0, 12)
    label.BackgroundTransparency = 1
    label.Text = text
    label.TextColor3 = Color3.fromRGB(190, 190, 200)
    label.TextSize = 11
    label.Font = Enum.Font.Gotham
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Parent = row

    local percentLabel = Instance.new("TextLabel")
    percentLabel.Size = UDim2.new(0.3, 0, 0, 12)
    percentLabel.Position = UDim2.new(0.7, 0, 0, 0)
    percentLabel.BackgroundTransparency = 1
    percentLabel.Text = defaultPercent .. "%"
    percentLabel.TextColor3 = Color3.fromRGB(0, 180, 255)
    percentLabel.TextSize = 10
    percentLabel.Font = Enum.Font.GothamBold
    percentLabel.TextXAlignment = Enum.TextXAlignment.Right
    percentLabel.Parent = row

    local track = Instance.new("Frame")
    track.Size = UDim2.new(1, 0, 0, 3)
    track.Position = UDim2.new(0, 0, 0, 17)
    track.BackgroundColor3 = Color3.fromRGB(60, 60, 70)
    track.BorderSizePixel = 0
    track.Parent = row

    local fill = Instance.new("Frame")
    fill.Size = UDim2.new(defaultPercent / 100, 0, 1, 0)
    fill.BackgroundColor3 = Color3.fromRGB(0, 180, 255)
    fill.BorderSizePixel = 0
    fill.Parent = track

    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, 0, 5, 0)
    btn.Position = UDim2.new(0, 0, -2, 0)
    btn.BackgroundTransparency = 1
    btn.Text = ""
    btn.Parent = track

    local dragging = false
    local function update(input)
        local rel = math.clamp((input.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
        local val = math.floor(rel * 100)
        fill.Size = UDim2.new(rel, 0, 1, 0)
        percentLabel.Text = val .. "%"
        pcall(function() if callback then callback(val) end end)
    end

    btn.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            update(input)
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            update(input)
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
end

