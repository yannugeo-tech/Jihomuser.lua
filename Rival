local AuraEnabled = false
local AuraConnection = nil
local AuraHue = 0
local auraParts = {}
local auraOrbitAngle = 0

local AURA_ORBIT_COUNT = 6

local function clearAura()
    for _, obj in ipairs(auraParts) do
        pcall(function() obj:Destroy() end)
    end
    auraParts = {}
end

local function createAuraPart(size)
    local p = Instance.new("Part")
    p.Size = size
    p.Anchored = true
    p.CanCollide = false
    p.CanQuery = false
    p.CanTouch = false
    p.Material = Enum.Material.Neon
    p.Shape = Enum.PartType.Ball
    p.TopSurface = Enum.SurfaceType.Smooth
    p.BottomSurface = Enum.SurfaceType.Smooth
    p.Parent = workspace
    return p
end

local function startAura()
    if AuraConnection then AuraConnection:Disconnect() end
    AuraEnabled = true
    clearAura()
    
    auraParts.orbitBalls = {}
    for i = 1, AURA_ORBIT_COUNT do
        local ball = createAuraPart(Vector3.new(0.6, 0.6, 0.6))
        ball.Transparency = 0.1
        table.insert(auraParts.orbitBalls, {
            part = ball,
            angleOffset = (i / AURA_ORBIT_COUNT) * math.pi * 2,
            heightOffset = (i % 2 == 0) and 1 or -1,
        })
        table.insert(auraParts, ball)
    end
    
    local floor = Instance.new("Part")
    floor.Name = "JikaiAuraFloor"
    floor.Shape = Enum.PartType.Cylinder
    floor.Size = Vector3.new(0.2, 8, 8)
    floor.Anchored = true
    floor.CanCollide = false
    floor.CanQuery = false
    floor.CanTouch = false
    floor.Material = Enum.Material.Neon
    floor.Transparency = 0.2
    floor.Parent = workspace
    auraParts.floorCircle = floor
    table.insert(auraParts, floor)
    
    local floor2 = Instance.new("Part")
    floor2.Name = "JikaiAuraFloor2"
    floor2.Shape = Enum.PartType.Cylinder
    floor2.Size = Vector3.new(0.15, 5, 5)
    floor2.Anchored = true
    floor2.CanCollide = false
    floor2.CanQuery = false
    floor2.CanTouch = false
    floor2.Material = Enum.Material.Neon
    floor2.Transparency = 0.3
    floor2.Parent = workspace
    auraParts.floorCircle2 = floor2
    table.insert(auraParts, floor2)
    
    auraParts.weaponBalls = {}
    
    AuraConnection = RunService.RenderStepped:Connect(function(dt)
        if not AuraEnabled then return end
        
        AuraHue = (AuraHue + dt * 200) % 360
        auraOrbitAngle = auraOrbitAngle + dt * 4
        local rainbow = Color3.fromHSV(AuraHue / 360, 1, 1)
        local rainbow2 = Color3.fromHSV(((AuraHue + 120) % 360) / 360, 1, 1)
        
        local char = LocalPlayer.Character
        if not char then return end
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if not hrp then return end
        
        if auraParts.orbitBalls then
            for i, data in ipairs(auraParts.orbitBalls) do
                local ball = data.part
                if ball and ball.Parent then
                    local angle = auraOrbitAngle + data.angleOffset
                    local radius = 3
                    local offset = Vector3.new(
                        math.cos(angle) * radius,
                        data.heightOffset * 1.5 + math.sin(angle * 2) * 0.5,
                        math.sin(angle) * radius
                    )
                    ball.CFrame = CFrame.new(hrp.Position + offset)
                    local hue = ((AuraHue + i * 40) % 360) / 360
                    ball.Color = Color3.fromHSV(hue, 1, 1)
                end
            end
        end
        
        if auraParts.floorCircle and auraParts.floorCircle.Parent then
            auraParts.floorCircle.CFrame = CFrame.new(hrp.Position - Vector3.new(0, 3, 0))
                * CFrame.Angles(0, math.rad(AuraHue * 2), math.rad(90))
            auraParts.floorCircle.Color = rainbow
        end
        if auraParts.floorCircle2 and auraParts.floorCircle2.Parent then
            auraParts.floorCircle2.CFrame = CFrame.new(hrp.Position - Vector3.new(0, 2.8, 0))
                * CFrame.Angles(0, math.rad(-AuraHue * 3), math.rad(90))
            auraParts.floorCircle2.Color = rainbow2
        end
        
        local tool = char:FindFirstChildOfClass("Tool")
        local handle = tool and tool:FindFirstChild("Handle")
        
        if handle then
            if #auraParts.weaponBalls < 3 then
                for i = 1, 3 do
                    local wb = createAuraPart(Vector3.new(0.4, 0.4, 0.4))
                    wb.Transparency = 0.1
                    table.insert(auraParts.weaponBalls, wb)
                    table.insert(auraParts, wb)
                end
            end
            for i, wb in ipairs(auraParts.weaponBalls) do
                if wb and wb.Parent then
                    local angle = auraOrbitAngle * 1.5 + (i / 3) * math.pi * 2
                    local offset = Vector3.new(
                        math.cos(angle) * 1.2,
                        math.sin(angle * 3) * 0.5,
                        math.sin(angle) * 1.2
                    )
                    wb.CFrame = CFrame.new(handle.Position + offset)
                    local hue = ((AuraHue + i * 60) % 360) / 360
                    wb.Color = Color3.fromHSV(hue, 1, 1)
                end
            end
        else
            if auraParts.weaponBalls then
                for _, wb in ipairs(auraParts.weaponBalls) do
                    if wb and wb.Parent then
                        wb.CFrame = CFrame.new(0, -500, 0)
                    end
                end
            end
        end
    end)
end

