    refreshConfigList = function()
        for _, c in ipairs(configListScroll:GetChildren()) do
            if c:IsA("TextButton") then c:Destroy() end
        end
        for name, data in pairs(_G.JikaiConfigs) do
            local btn = Instance.new("TextButton")
            btn.Size = UDim2.new(1, 0, 0, 22)
            btn.BackgroundColor3 = Color3.fromRGB(45, 45, 55)
            btn.Text = name
            btn.TextColor3 = Color3.fromRGB(200, 200, 210)
            btn.TextSize = 11
            btn.Font = Enum.Font.Gotham
            btn.BorderSizePixel = 0
            btn.Parent = configListScroll
            local bStroke = Instance.new("UIStroke")
            bStroke.Color = Color3.fromRGB(60, 60, 70)
            bStroke.Thickness = 1
            bStroke.Parent = btn
            btn.MouseButton1Click:Connect(function()
                local d = data
                if d.rage then
                    _G.JikaiRage.text = d.rage.text
                    _G.JikaiRage.transparency = d.rage.transparency
                    _G.JikaiRage.textSize = d.rage.textSize
                    _G.JikaiRage.neon = d.rage.neon
                    _G.JikaiRage.rainbow = d.rage.rainbow
                    _G.JikaiRage.solidColor = d.rage.solidColor
                    _G.JikaiRage.showIndicator = d.rage.showIndicator
                end
                if d.yokaiText and YokaiTextLabel then
                    YokaiText = d.yokaiText
                    YokaiTextLabel.Text = YokaiText
                end
                if d.lighting then
                    for k, v in pairs(d.lighting) do
                        pcall(function() Lighting[k] = v end)
                    end
                end
            end)
        end
    end
    refreshConfigList()
end

