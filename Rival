end

local BaitEnabled = false
local BaitConnection = nil
local BaitMode = "random"

local function startBait()
    if BaitConnection then BaitConnection:Disconnect() end
    BaitEnabled = true
    
    BaitConnection = RunService.Heartbeat:Connect(function()
        if not BaitEnabled then return end
        local char = LocalPlayer.Character
        if not char then return end
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if not hrp then return end
        
        local newPos
        
        if BaitMode == "random" then
            newPos = hrp.Position + Vector3.new(
                math.random(-25, 25),
                math.random(-8, 12),
                math.random(-25, 25)
            )
        elseif BaitMode == "nearEnemy" then
            local closest, shortest = nil, math.huge
            for _, plr in ipairs(Players:GetPlayers()) do
                if plr ~= LocalPlayer and plr.Character then
                    local eHrp = plr.Character:FindFirstChild("HumanoidRootPart")
                    if eHrp then
                        local d = (eHrp.Position - hrp.Position).Magnitude
                        if d < shortest then shortest = d; closest = eHrp end
                    end
                end
            end
            if closest then
                newPos = closest.Position + Vector3.new(
                    math.random(-8, 8), 0, math.random(-8, 8)
                )
            else
                newPos = hrp.Position + Vector3.new(math.random(-15,15), 5, math.random(-15,15))
            end
        elseif BaitMode == "nearEdge" then
            newPos = hrp.Position + Vector3.new(
                math.random(-40, 40),
                math.random(-3, 20),
                math.random(-40, 40)
            )
        end
        
        hrp.CFrame = CFrame.new(newPos)
        hrp.Velocity = Vector3.new(0, 0, 0)
    end)
end

local function stopBait()
    BaitEnabled = false
    if BaitConnection then
        BaitConnection:Disconnect()
        BaitConnection = nil
    end
end

